# Required: Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=
# Only for keys not scoped to a workspace: Console -> Settings -> Workspaces (wrkspc_...)
# ANTHROPIC_WORKSPACE_ID=

# Telegram bot (zeppelin-bot): token from @BotFather
TELEGRAM_BOT_TOKEN=
# Optional: comma-separated Telegram user IDs allowed to use the bot; empty = everyone
# TELEGRAM_ALLOWED_USERS=
# Optional: questions per user per day; each question spends Anthropic API credits
# TELEGRAM_DAILY_LIMIT=20

# Optional overrides (defaults shown)
# ZEPPELIN_ANSWER_MODEL=claude-opus-5
# ZEPPELIN_ANSWER_EFFORT=medium
# ZEPPELIN_FAST_MODEL=claude-haiku-4-5
# ZEPPELIN_JUDGE_MODEL=claude-sonnet-5
# ZEPPELIN_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# ZEPPELIN_TOP_K=4
# ZEPPELIN_LEXICAL_WEIGHT=0.5
# ZEPPELIN_MAX_REWRITES=2
# ZEPPELIN_MULTI_QUERY=1
# ZEPPELIN_MAX_SUBQUERIES=3
# ZEPPELIN_MAX_CHUNKS=8
